# Opt-in sign-in. Copy to .env.local, or export the three names before `make web`.
# With any of the three absent or blank the "Sign in" control is hidden and the dataset browser is
# unchanged. Vite reads these at build/dev-server start; restart `make web` after a change.
# The web client's registered callback is http://localhost:5173/auth/callback, so sign in on WEB_PORT 5173.
VITE_COGNITO_DOMAIN=asteroidea-<account-id>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<web app client id>
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com
